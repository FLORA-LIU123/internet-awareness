# Streamlit Cloud Secrets 配置模板
# 在 Streamlit Cloud 的 App settings → Secrets 中粘贴以下内容

# 访问密码（设置后用户需要输入密码才能访问平台）
APP_PASSWORD = "your_secure_password_here"

# AlienVault OTX API 密钥（从 https://otx.alienvault.com/ 免费获取）
OTX_API_KEY = "your_otx_api_key_here"

# 可选：自定义配置
# [database]
# path = "data/metrics.db"

# [collection]
# interval_minutes = 60